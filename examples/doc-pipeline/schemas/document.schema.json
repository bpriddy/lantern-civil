{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civil.local/doc-pipeline/document.schema.json",
  "title": "Document",
  "type": "object",
  "required": ["id", "body"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "body": { "type": "string" },
    "source": { "type": "string" },
    "receivedAt": { "type": "string", "format": "date-time" }
  }
}
