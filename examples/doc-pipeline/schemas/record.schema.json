{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civil.local/doc-pipeline/record.schema.json",
  "title": "Record",
  "type": "object",
  "required": ["id", "category", "confidence"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "enum": ["invoice", "contract", "correspondence", "other"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string" },
    "enrichedFrom": { "type": "array", "items": { "type": "string" } }
  }
}
