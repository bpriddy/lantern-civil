node_modules/
dist/
*.tsbuildinfo

# Civil project working state — never truth, always reconstructible (PRD 12)
.civil/

# Local env and secrets — never in the repo (PRD 2)
.env
.env.local
*.tfvars
!example.tfvars

# Downloaded OAuth client files. These carry client_secret and have no business in a
# repo — the values belong in Secret Manager. Named broadly because Google's download
# name varies (client_secret_*.json) and people rename them.
civil-auth.json
client_secret*.json
*-oauth*.json
*credentials*.json

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log

# Python runtime
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local Postgres data directory
.pgdata/

.DS_Store
