# Copy to .env for local development. PRD 2: secrets in env and Secret Manager,
# never in the repo. .env is gitignored.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

DATABASE_URL=postgres://localhost:5432/civil_dev

# Stands in for IAP on a laptop. config.ts refuses to boot if this is set in
# production, because it bypasses authentication entirely.
CIVIL_DEV_IDENTITY=colorandsound@gmail.com

# Set in production by Terraform, not here:
# CIVIL_IAP_AUDIENCE=/projects/<number>/locations/global/backendServices/<id>
# CIVIL_VERIFY_IAP_JWT=true

# GitHub App (PRD 12). Required for repository-backed projects; without them Civil
# runs fine against a local project source. The private key is the .pem GitHub gave
# you, inlined — keep it out of the repo.
# GITHUB_APP_ID=4642132
# GITHUB_CLIENT_ID=Iv23lik8E7sEYwlccpGF
# GITHUB_CLIENT_SECRET=
# GITHUB_APP_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Where the runner listens. dev.sh starts it here; unset means runs cannot execute.
CIVIL_RUNNER_URL=http://127.0.0.1:8081
CIVIL_RUNNER_PORT=8081

# Where the session service listens (docs/app-session.md). Development defaults to
# this value; production leaves it unset until a deployed substrate exists.
CIVIL_SESSION_URL=http://127.0.0.1:8082
CIVIL_SESSION_PORT=8082

# Model access for agent nodes — the platform's one key (PRD 12). Add your own;
# never commit it. Without it, agent nodes fail with a message saying so.
# ANTHROPIC_API_KEY=
